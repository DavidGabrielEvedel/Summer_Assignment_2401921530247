class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
    int n=nums.size();
    double avg,sum=0.00000;
    for(int i=0; i<k; i++)
    {
       sum=sum+nums[i];
    }
    avg=sum/k;
    for(int i=k;i<n;i++)
    {
        sum-=nums[i-k];
        sum+=nums[i];
        avg=max(avg,sum/k);
    } 
    return avg;  
    }
};
